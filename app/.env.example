# Пример файла настроек окружения.
# Скопируйте этот файл в .env (без .example) и подставьте свои значения.
# Файл .env в репозиторий не коммитится — он указан в .gitignore.

# --- Django ---
# Любая длинная случайная строка. Сгенерировать можно командой:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# Режим разработки. В production должен быть False.
DJANGO_DEBUG=True

# Список хостов, с которых разрешено принимать запросы (через запятую).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
# Реквизиты, которые вы зададите при создании БД (см. README, шаг 3).
POSTGRES_DB=ticket_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
